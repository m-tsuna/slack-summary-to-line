# このファイルをコピーして名前を .env にし、= の後ろに値を書いてください（.env は GitHub に載せません）。

# Slack アプリの Bot User OAuth Token（xoxb- で始まる。スコープは channels:history だけ）
SLACK_BOT_TOKEN=
# 読みたい公開チャンネルの ID（C で始まる。チャンネル詳細の一番下）
SLACK_CHANNEL_ID=

# OpenAI の API キー（sk- で始まる）
OPENAI_API_KEY=

# LINE Developers の「Messaging API 設定」にあるチャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=
# 「チャネル基本設定」にある「あなたのユーザー ID」（U で始まる33文字）
LINE_USER_ID=
